# Supply to the backend via your IDE/shell or Render Environment.
# Spring Boot does not load this file automatically. Docker Compose reads it for pgvector.
SPRING_PROFILES_ACTIVE=ai
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=3072

PGVECTOR_URL=jdbc:postgresql://localhost:5433/stationery_ai
PGVECTOR_USERNAME=stationery_ai
PGVECTOR_PASSWORD=
PGVECTOR_TABLE=stationery_vectors_gemini

AI_VIEW_WEIGHT=1
AI_CART_WEIGHT=3
AI_PURCHASE_WEIGHT=5
AI_HALF_LIFE_DAYS=30
AI_HISTORY_DAYS=180
TRACKING_VIEW_COOLDOWN_SECONDS=300
AI_CHAT_REQUESTS_PER_MINUTE=10
AI_INDEX_DELAY_MS=60000
AI_TIMEOUT=30s
AI_VECTOR_TIMEOUT=5s

# Existing application settings: retain your own values during migration.
SQLSERVER_URL=jdbc:sqlserver://localhost:1433;databaseName=stationery_shop;encrypt=true;trustServerCertificate=true
SQLSERVER_USERNAME=sa
SQLSERVER_PASSWORD=
JWT_SECRET_BASE64=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_RESET_PASSWORD_URL=http://localhost:5173/reset-password
