{
  "info": {
    "name": "Task 03 - Product Type API",
    "description": "Set baseUrl, adminToken and customerToken, then run in order. Requires a running backend, SQL Server and valid ADMIN/CUSTOMER bearer tokens. Uses random names and creates two test categories; DELETE leaves both rows inactive. No real credentials or tokens are stored in this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List product types (public)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/product-types"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('response is a list', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get missing product type",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/product-types/0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', () => pm.response.to.have.status(404));",
              "pm.test('error detail is present', () => pm.expect(pm.response.json().detail).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create product type with default active state",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/product-types",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"  {{productTypeName}}  \"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('productTypeID');",
              "pm.collectionVariables.unset('otherProductTypeID');",
              "pm.collectionVariables.set('productTypeName', 'Task03 ' + pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('otherName', 'Other ' + pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('renamedName', 'Renamed ' + pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const result = pm.response.json();",
              "pm.test('name is trimmed and status defaults to active', () => { pm.expect(result.name).to.eql(pm.collectionVariables.get('productTypeName')); pm.expect(result.isActive).to.eql(true); pm.expect(result.productTypeID).to.be.a('number'); });",
              "if (pm.response.code === 201) pm.collectionVariables.set('productTypeID', result.productTypeID);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get created product type",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/product-types/{{productTypeID}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('created category is returned', () => { pm.expect(result.productTypeID).to.eql(Number(pm.collectionVariables.get('productTypeID'))); pm.expect(result.name).to.eql(pm.collectionVariables.get('productTypeName')); });"
            ]
          }
        }
      ]
    },
