{
  "info": {
    "name": "Task 14 - Statistics API (UC035-UC037)",
    "description": "Read-only requests for ADMIN statistics. Set adminToken/customerToken and date variables. The emptyDate must be a date with no orders. Product revenue is SUM(order_details.sub_total); order revenue is SUM(orders.total_amount) after discounts. Approval of a return is not a refund. Current schema has no confirmed refund amount, so net revenue after refunds is not claimed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "Overview - current month by default",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/statistics/overview"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('month boundaries are returned', () => { pm.expect(result.startDate.slice(-2)).to.eql('01'); pm.expect(result.startDate.slice(0,7)).to.eql(result.endDate.slice(0,7)); });",
              "pm.test('summary fields are numeric', () => { for (const key of ['totalOrders','successfulOrders','totalRevenue','totalDiscount','quantitySold','totalCustomers','newCustomers']) pm.expect(result[key], key).to.be.a('number'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Overview - selected period",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/statistics/overview?startDate={{startDate}}&endDate={{endDate}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('requested dates are returned', () => { pm.expect(result.startDate).to.eql(pm.variables.get('startDate')); pm.expect(result.endDate).to.eql(pm.variables.get('endDate')); });"
            ]
          }
        }
      ]
    },
    {
      "name": "UC035 - revenue grouped by DAY",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/statistics/revenue?startDate={{startDate}}&endDate={{endDate}}&groupBy=DAY"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('grouping is DAY', () => pm.expect(result.groupBy).to.eql('DAY'));",
              "pm.test('periods is an array', () => pm.expect(result.periods).to.be.an('array'));",
              "pm.test('totals equal period sums', () => { pm.expect(result.totalRevenue).to.be.closeTo(result.periods.reduce((sum,p) => sum + p.totalRevenue,0),0.01); pm.expect(result.totalDiscount).to.be.closeTo(result.periods.reduce((sum,p) => sum + p.totalDiscount,0),0.01); pm.expect(result.successfulOrders).to.eql(result.periods.reduce((sum,p) => sum + p.orderCount,0)); });"
            ]
          }
        }
      ]
    },
