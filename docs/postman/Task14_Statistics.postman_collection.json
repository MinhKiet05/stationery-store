    {
      "name": "Order and return request status counts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/statistics/orders?startDate={{startDate}}&endDate={{endDate}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('all order statuses are included', () => { for(const key of ['PENDING','PROCESSING','SHIPPED','DELIVERED','CANCELLED','RETURN_PENDING']) pm.expect(result.statusCounts[key],key).to.be.a('number'); });",
              "pm.test('total matches status counts', () => pm.expect(result.totalOrders).to.eql(Object.values(result.statusCounts).reduce((a,b) => a+b,0)));",
              "pm.test('current return statuses are included', () => { for(const key of ['PENDING','APPROVED','REJECTED','COMPLETED']) pm.expect(result.returnRequestCounts[key],key).to.be.a('number'); });"
            ]
          }
        }
      ]
    },
