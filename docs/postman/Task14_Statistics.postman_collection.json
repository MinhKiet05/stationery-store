    {
      "name": "UC036 - customers sorted by REVENUE",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/statistics/customers?startDate={{startDate}}&endDate={{endDate}}&sortBy=REVENUE&limit=5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('ranking is REVENUE', () => pm.expect(result.sortBy).to.eql('REVENUE'));",
              "pm.test('limited ranking contains no credential fields', () => { pm.expect(result.customers).to.be.an('array'); pm.expect(result.customers.length).to.be.at.most(5); result.customers.forEach(c => { pm.expect(c).not.to.have.property('passwordHash'); pm.expect(c).not.to.have.property('password'); }); });",
              "const key = 'totalPaid';",
              "pm.test('ranking is descending', () => { for(let i=1;i<result.customers.length;i++) pm.expect(result.customers[i-1][key]).to.be.at.least(result.customers[i][key]); });"
            ]
          }
        }
      ]
    },
