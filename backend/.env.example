# Safe example only. Supply via Render Environment or your IDE; Spring Boot does not load .env automatically.
SPRING_PROFILES_ACTIVE=ai
PORT=10000

# Optional Redis Cloud. Match the database's actual port/TLS settings when enabling.
# Security counters/reset tokens share this database: verify noeviction before enabling.
# Eviction of a rate-limit counter resets its window. See docs/redis-integration.md.
REDIS_ENABLED=false
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
# Use distinct values (local/staging/production) when environments share Redis.
CACHE_ENVIRONMENT=local
# Required when Redis is enabled: separate random Base64 secret, at least 32 decoded bytes.
PASSWORD_RESET_HMAC_SECRET_BASE64=
# Only verified ingress proxy IPs/CIDRs, comma separated. Empty means ignore forwarded headers.
TRUSTED_PROXY_CIDRS=
LOGIN_MAX_FAILURES=5
LOGIN_IP_MAX_FAILURES=50
LOGIN_WINDOW_SECONDS=300
REGISTER_MAX_REQUESTS=5
REGISTER_WINDOW_SECONDS=900
FORGOT_MAX_REQUESTS=3
FORGOT_WINDOW_SECONDS=900
RESET_MAX_REQUESTS=30
RESET_WINDOW_SECONDS=60
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Spring Cache infrastructure accepts only ordinary:* caches, never OTP/auth/rate-limit storage.

# Optional review image uploads (server-side only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Same Supabase project, session pooler (IPv4). Business tables live in private schema store.
DATABASE_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=<SUPABASE_DATABASE_PASSWORD>

# Separate pool for public vector table; extensions schema is exposed through connection init SQL.
PGVECTOR_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
PGVECTOR_USERNAME=YOUR_DATABASE_USERNAME
PGVECTOR_PASSWORD=<SUPABASE_DATABASE_PASSWORD>
PGVECTOR_TABLE=stationery_vectors_gemini

AI_ENABLED=true
GEMINI_API_KEY=<GEMINI_API_KEY>
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=3072
JWT_SECRET_BASE64=<BASE64_ENCODED_SECRET_AT_LEAST_32_BYTES>

# Render Free: prefer Brevo HTTPS (443). Set resend or smtp explicitly for alternatives.
MAIL_PROVIDER=brevo
BREVO_API_KEY=<BREVO_API_KEY_NOT_SMTP_KEY>
MAIL_FROM=stationerystoreservice@gmail.com
MAIL_FROM_NAME=Stationery Store
MAIL_CONNECT_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=10000
# Verify this sender in Brevo and activate transactional sending before deployment.
# IMPORTANT: Brevo rewrites free mailbox From addresses for transactional email.
# A Gmail sender cannot guarantee the exact visible From address; the application never substitutes it.
# https://help.brevo.com/hc/en-us/articles/14925263522578
# Resend remains available for verified domains/testing; no automatic fallback.
RESEND_API_KEY=<RESEND_API_KEY_IF_PROVIDER_IS_RESEND>
# SMTP is retained for environments with SMTP egress. For port 465 use SSL=true, STARTTLS=false.
SMTP_STARTTLS_ENABLED=true
SMTP_SSL_ENABLED=false
# Gmail SMTP requires a Render plan that allows outbound SMTP port 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<GMAIL_ADDRESS>
SMTP_PASSWORD=<GMAIL_APP_PASSWORD>
SMTP_FROM=<GMAIL_ADDRESS>

FRONTEND_URL=https://stationery-store-nu.vercel.app
FRONTEND_RESET_PASSWORD_URL=https://stationery-store-nu.vercel.app/reset-password

AI_VIEW_WEIGHT=1
AI_CART_WEIGHT=3
AI_PURCHASE_WEIGHT=5
AI_HALF_LIFE_DAYS=30
AI_HISTORY_DAYS=180
AI_CHAT_REQUESTS_PER_MINUTE=10
AI_INDEX_DELAY_MS=60000
AI_TIMEOUT=30s
AI_VECTOR_TIMEOUT=5s
TRACKING_VIEW_COOLDOWN_SECONDS=300
