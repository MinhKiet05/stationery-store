            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set(\"userId\", data.userID);",
                  "pm.test(\"No credential fields\", () => { pm.expect(data).not.to.have.property(\"passwordHash\"); pm.expect(data).not.to.have.property(\"password\"); });"
