{
  "info": {
    "name": "Stationery Store - Task 07 User and Task 09 Coupon",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run on a disposable test database. Configure account credentials and a unique profileEmail. The status and password folders modify the test customer and restore it on success. Preview never consumes usage."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "customerUsername",
      "value": ""
    },
    {
      "key": "customerPassword",
      "value": ""
    },
    {
      "key": "adminUsername",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "profileEmail",
      "value": ""
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "couponId",
      "value": ""
    },
    {
      "key": "couponCode",
      "value": "TASK709_TEST"
    },
    {
      "key": "temporaryPassword",
      "value": "TemporaryPassword709!"
